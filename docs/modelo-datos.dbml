Table categoria {
  id bigint [pk, increment]
  nombre varchar(100) [not null, unique]
}

Table gasto {
  id bigint [pk, increment]
  descripcion varchar(255) [not null]
  monto numeric(12,2) [not null]
  fecha date [not null]
  categoria_id bigint [not null]
}

Ref: gasto.categoria_id > categoria.id